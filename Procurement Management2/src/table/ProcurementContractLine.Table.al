table 53005 "Procurement Contract Line"
{
    Caption = 'Procurement Contract Line';
    DataClassification = ToBeClassified;

    fields
    {
        field(1; "Contract No."; Code[50])
        {
            Caption = 'Contract No.';
            DataClassification = CustomerContent;
        }
        field(2; "Line No."; Integer)
        {
            Caption = 'Milestone No.';
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(3; "Start Date"; Date)
        {
            Caption = 'Start Date';
            DataClassification = CustomerContent;
            trigger OnValidate()
            begin
                //if "Contract Length" <> '' then
                "End Date" := CalcDate("Contract Length", "Start Date");
            end;
        }
        field(4; "End Date"; Date)
        {
            Caption = 'End Date';
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(5; "Created By"; Code[20])
        {
            Caption = 'Created By';
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(6; "Date-Time Created"; DateTime)
        {
            Caption = 'Date-Time Created';
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(7; "Contract Length"; DateFormula)
        {
            Caption = 'Contract Length';
            DataClassification = CustomerContent;

            trigger OnValidate()
            begin
                "End Date" := CalcDate("Contract Length", "Start Date");
            end;
        }
        field(8; Amount; Decimal)
        {
            DataClassification = CustomerContent;
            Caption = 'Amount';
        }
        field(9; "Milestone Description"; Text[250])
        {
            DataClassification = CustomerContent;
            Caption = 'Milestone Description';
        }
        field(10; "Invoice No."; Code[50])
        {
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(11; "Invoice Generated"; Boolean)
        {
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(12; "Invoice Posted"; Boolean)
        {
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(13; Selected; Boolean)
        {
            DataClassification = CustomerContent;

            trigger OnValidate()
            begin
                if Selected then
                    "Selected By" := UserId()
                else
                    "Selected By" := '';
            end;
        }
        field(14; "Generated By"; Code[50])
        {
            DataClassification = CustomerContent;
            Editable = false;
        }
        field(15; "LPO No."; Code[50])
        {
            DataClassification = ToBeClassified;
        }
        field(16; "Selected By"; Code[50])
        {
            DataClassification = ToBeClassified;
            Editable = false;
        }
        field(17; "Posted Invoice No."; Code[50])
        {
            DataClassification = ToBeClassified;
            Editable = false;
        }
    }
    keys
    {
        key(PK; "Contract No.", "Line No.")
        {
            Clustered = true;
        }
    }

    trigger OnInsert()
    begin
        "Date-Time Created" := CurrentDateTime();
        "Created By" := UserId();
    end;
}






