                            <Textbox Name="Textbox15">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>We are pleased to inform you that, following the completion of the evaluation process for the tender/RFQ/RFP </Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=First(Fields!Title.Value, "DataSet_Result")</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> , your company, has been selected as the successful bidder.</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>This award is based on your submission and in accordance with the terms and conditions outlined in the Request for Proposal (RFP)/Invitation to Bid (ITB)/Request For Quote(RFQ). You are hereby awarded the contract for </Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!Title.Value</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <TextDecoration>Underline</TextDecoration>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> at a total contract value of  </Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=First(Fields!TotalAmountREg.Value, "DataSet_Result")</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <Format>n2</Format>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> , inclusive of all applicable taxes and charges.</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value />
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Please be advised that this award is subject to the signing of a formal contract between our two parties. You are expected to:</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Confirm your acceptance of this award in writing within   days from the date of this letter.</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <ListStyle>Numbered</ListStyle>
                                  <ListLevel>1</ListLevel>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Present the necessary documentation (e.g., valid business license, tax compliance certificate, performance security, etc.) as outlined in the solicitation documents.</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <ListStyle>Numbered</ListStyle>
                                  <ListLevel>1</ListLevel>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value />
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <ListLevel>1</ListLevel>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Upon receipt of your confirmation and fulfillment of the pre-contract requirements, we shall proceed with finalizing the contract for signature.</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>We appreciate your interest in partnering with  and look forward to a successful engagement.</Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Should you have any questions or need clarification, please do not hesitate to contact us at </Value>
                                      <Style>
                                        <FontStyle>Normal</FontStyle>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>12pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                        <TextDecoration>None</TextDecoration>
                                        <Color>#000000</Color>
                                      </Style>
                                    </TextRun>
