                  <LineHeight>100pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>This LPO is valid for 30 days </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>All the goods/Services supplied MUST be as per the order and MUST meet all the specified conditions.</Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Goods/Services are received subject to verification in due course.</Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>The prices on the LPO include delivery costs to the specified delivery/receiving point.</Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Payment terms:Payment shall be made 30 days after the invoice date.</Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
