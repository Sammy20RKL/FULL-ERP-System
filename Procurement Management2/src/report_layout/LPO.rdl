          <Textbox Name="Textbox9">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Terms and Conditions </Value>
                    <Style>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                  <LineHeight>100pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                  <LineHeight>100pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>This order is made for delivery of goods / services specified herein within 14 days of the date thereof. </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Prices will include packaging, VAT and all other taxes where applicable. </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Suppliers are cautioned not to supply good against any order than this form. </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>The Financial Reporting Centre reserves the right to inspect goods on this order, but such inspection  does not relieve the supplier of his/her responsibility for defects in materials and/or workmanship.</Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>The Financial Reporting Centre reserve the right to reject goods delivered / services not rendered within 14 days of this order and shall not be responsible for any consequential loss or damage occasioned thereby. </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Demurrage or other incidental expenses incurred owing to the supplier not complying with our instructions will be for the supplier’s accounts. </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Suppliers are responsible for delivery of invoices and delivery notes to the authority. </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Full payments for the goods and services satisfactorily supplied/ rendered and inspected as in 4 above will be made after delivery.</Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>All inquiries should be addressed to: 


The Chief Executive 
Financial Reporting Centre
29th floor, UAP Towers 
Upper Hill
P.O Box 1000001 
Nairobi 
Kenya 
Tel: -------
Fax: -------
Email: info@frc.go.ke </Value>
                    <Style />
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>5pt</SpaceAfter>
                <Style />
              </Paragraph>
            </Paragraphs>
